{
  "title": "Delhi Air Quality — Monitoring",
  "uid": "delhi-aq-monitoring",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 38,
  "time": { "from": "now-72h", "to": "now" },
  "timepicker": {},
  "tags": ["delhi", "air-quality", "mlops"],
  "panels": [
    {
      "id": 1,
      "title": "PM2.5 Actuel (observé)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT pm25_observe AS \"PM2.5 µg/m³\" FROM predictions ORDER BY datetime DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "µg/m³",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 300 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 2,
      "title": "PM2.5 Prédit (XGBoost)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT pm25_predit AS \"XGBoost µg/m³\" FROM predictions ORDER BY datetime DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "µg/m³",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 300 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "title": "Catégorie NAQI actuelle",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT aqi_category AS \"Catégorie\" FROM predictions ORDER BY datetime DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "Good": { "color": "green" }, "Satisfactory": { "color": "light-green" }, "Moderate": { "color": "yellow" }, "Poor": { "color": "orange" }, "Very Poor": { "color": "red" }, "Severe": { "color": "dark-red" } } }
      ] } }
    },
    {
      "id": 4,
      "title": "Dépassements NAQI (72h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS \"Dépassements\" FROM predictions WHERE depasse_naqi = true AND datetime >= NOW() - INTERVAL '72 hours'",
        "format": "table",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 }] }, "color": { "mode": "thresholds" } } }
    },
    {
      "id": 5,
      "title": "PM2.5 — Observé vs XGBoost (72h)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT datetime AS time, pm25_observe AS \"PM2.5 Observé\", pm25_predit AS \"XGBoost\" FROM predictions WHERE datetime >= NOW() - INTERVAL '72 hours' ORDER BY datetime ASC",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "µg/m³", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PM2.5 Observé" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "XGBoost" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }, { "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "title": "Niveau PM2.5 actuel",
      "type": "gauge",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT pm25_observe AS \"PM2.5\" FROM predictions ORDER BY datetime DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "µg/m³",
          "min": 0, "max": 500,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "light-green", "value": 50 },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 300 },
              { "color": "dark-red", "value": 400 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Erreur Absolue XGBoost (72h)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT datetime AS time, ABS(pm25_observe - pm25_predit) AS \"Erreur XGBoost\" FROM predictions WHERE datetime >= NOW() - INTERVAL '72 hours' ORDER BY datetime ASC",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "µg/m³", "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "title": "Historique des prédictions",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT datetime AS \"Heure\", pm25_observe AS \"Observé\", pm25_predit AS \"XGBoost\", aqi_category AS \"Catégorie NAQI\", CASE WHEN depasse_naqi THEN '⚠ Oui' ELSE 'Non' END AS \"Dépasse NAQI\" FROM predictions ORDER BY datetime DESC LIMIT 24",
        "format": "table",
        "refId": "A"
      }],
      "options": { "sortBy": [] },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } } }
    },
    {
      "id": 9,
      "title": "Journal du Pipeline",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "postgres", "uid": "delhi-postgres" },
      "targets": [{
        "rawSql": "SELECT run_at AS \"Exécuté le\", statut AS \"Statut\", nouvelles_lignes AS \"Lignes ingérées\", pm25_actuel AS \"PM2.5 actuel\", message AS \"Message\" FROM pipeline_runs ORDER BY run_at DESC LIMIT 10",
        "format": "table",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [{ "matcher": { "id": "byName", "options": "Statut" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "mappings", "value": [{ "type": "value", "options": { "OK": { "color": "green", "index": 0 }, "WARN": { "color": "orange", "index": 1 }, "ERROR": { "color": "red", "index": 2 } } }] }] }]
      }
    }
  ]
}
